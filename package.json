{
  "name": "daffa-profile-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal profile information system with GSAP, Motion, Lenis, and a superadmin CMS.",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "db:init": "node server/init-db.js",
    "reset:admin": "node server/reset-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "gsap": "^3.15.1",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.28",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.7",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
