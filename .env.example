# Salin file ini menjadi .env lalu sesuaikan nilainya.
#   PowerShell : Copy-Item .env.example .env
#   Bash       : cp .env.example .env

# Port server API + website produksi
PORT=4000
HOST=0.0.0.0

# Kredensial superadmin awal.
# HANYA dipakai saat data/database.json pertama kali dibuat (seed).
# Jika database sudah ada, ubah akun lewat menu "Akun superadmin" di /admin.
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=ganti-password-ini

# Kunci penandatangan sesi (JWT). Wajib diganti dengan string acak panjang.
# Contoh membuat nilai acak: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang

# ------------------------------------------------------------------
# Supabase (opsional, untuk database PostgreSQL)
# ------------------------------------------------------------------
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Connection string PostgreSQL (Session Pooler):
# Dashboard -> Project Settings -> Database -> Connection string -> Session pooler
# Contoh: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Jika kosong, aplikasi memakai data/database.json.
DATABASE_URL=

# ------------------------------------------------------------------
# Sinkron konten ke GitHub (opsional)
# ------------------------------------------------------------------
# Fine-grained token dengan akses Contents: Read and write pada repo.
# Snapshot hanya berisi konten publik; akun, pesan, dan hash password tidak ikut.
GITHUB_SYNC_TOKEN=
GITHUB_REPO=mdaffaalaudintrenggale/geminiraka
GITHUB_BRANCH=main
GITHUB_CONTENT_PATH=content/site-snapshot.json
GITHUB_SYNC_DELAY=1200
